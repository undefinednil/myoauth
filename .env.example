# MyOAuth environment overrides.
#
# Copy to `.env` and edit the values you need:
#
#   cp .env.example .env
#
# `docker compose` loads this file into the container (see docker-compose.yml).
# Environment variables WIN over conf.json; an empty or unset variable leaves the
# JSON value untouched, so you only set what differs from the Docker defaults.

# --- Core -------------------------------------------------------------------
# Public issuer URL used in discovery / the JWT `iss` claim and as the default
# forward-auth origin. No trailing slash.
MYOAUTH_OIDC_ISSUER=https://oauth.example.com
# Hosted login page URL used by /authorize.
MYOAUTH_OIDC_LOGIN_URL=https://oauth.example.com/login
# Shared secret required to register; change it before going live.
MYOAUTH_INVITATION_CODE=change-me

# --- Admin password (bcrypt hash, never plaintext) --------------------------
# Generate a hash, then paste the whole hash here. A bcrypt hash contains `$`
# characters; Docker Compose passes env_file values through literally, but if
# your Compose version warns about interpolation escape each `$` as `$$`.
#
#   # htpasswd (apache2-utils / httpd-tools), cost 12:
#   htpasswd -bnBC 12 "" 'YourStrongPassword' | tr -d ':\n'
#
#   # or with the project's own helper:
#   cat > /tmp/bcrypt.go <<'EOF'
#   package main
#
#   import (
#       "fmt"
#       "os"
#
#       "github.com/zenpk/my-oauth/util"
#   )
#
#   func main() {
#       hash, err := util.BCryptPassword(os.Args[1])
#       if err != nil {
#           panic(err)
#       }
#       fmt.Println(hash)
#   }
#   EOF
#   go run /tmp/bcrypt.go 'YourStrongPassword'
MYOAUTH_ADMIN_PASSWORD=$2a$12$REPLACE_WITH_YOUR_BCRYPT_HASH

# --- Optional core overrides (Docker defaults already in conf.json) ---------
# MYOAUTH_HTTP_ADDRESS=0.0.0.0:20476
# MYOAUTH_SECURE_COOKIES=true
# MYOAUTH_TRUST_PROXY=true
# MYOAUTH_DB_PATH=/data/myoauth.db
# MYOAUTH_LOG_FILE_PATH=/data/my-oauth.log
# MYOAUTH_RSA_PRIVATE_KEY_PATH=/config/oauth.private.pem
# MYOAUTH_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
# MYOAUTH_PASSWORD_MIN_LENGTH=8

# --- Forward auth (replaces oauth2-proxy) -----------------------------------
# Enable and configure the built-in forward-auth backend (accepted values:
# true/false/1/0/yes/no, case-insensitive). Left commented so a copied `.env`
# does not force an active value that overrides conf.json. Set it to `true`
# together with the secrets below to enable it; you only need this when you put
# nginx `auth_request` in front of an app; see nginx.forward-auth.example.conf.
# MYOAUTH_FORWARD_AUTH_ENABLED=true
# MYOAUTH_FORWARD_AUTH_CLIENT_ID=proxy
# Required when enabled; generate secrets with `openssl rand -hex 32`:
# MYOAUTH_FORWARD_AUTH_CLIENT_SECRET=
# MYOAUTH_FORWARD_AUTH_COOKIE_SECRET=
# MYOAUTH_FORWARD_AUTH_COOKIE_NAME=_myoauth_proxy
# MYOAUTH_FORWARD_AUTH_COOKIE_DOMAIN=
# Set true whenever the flow is served over HTTPS.
# MYOAUTH_FORWARD_AUTH_COOKIE_SECURE=true
# Exact app origins allowed to run the login flow (comma-separated).
# MYOAUTH_FORWARD_AUTH_ALLOWED_CALLBACK_ORIGINS=https://app.example.com
# Extra hosts accepted for an absolute `rd` return URL (comma-separated).
# MYOAUTH_FORWARD_AUTH_ALLOWED_REDIRECT_DOMAINS=
