# MyOAuth configuration.
#
# This file is THE configuration file: MyOAuth reads every setting from the
# environment, and MyOAuth captures it from the MYOAUTH_* variables below. Copy
# it and edit the values you need:
#
#   cp .env.example .env
#
# `docker compose` loads `.env` into the container (see docker-compose.yml).
# Unset or empty variables fall back to the image/ENV defaults or the built-in
# defaults, so you only set what differs.
#
# REQUIRED (the server refuses to boot without them):
#   - MYOAUTH_OIDC_ISSUER
#   - MYOAUTH_ADMIN_PASSWORD
#   - MYOAUTH_INVITATION_CODE
#
# The Docker image already sets these ENV defaults (override in `.env` only if
# you need to):
#   MYOAUTH_HTTP_ADDRESS=0.0.0.0:20476
#   MYOAUTH_DB_PATH=/data/myoauth.db
#   MYOAUTH_LOG_FILE_PATH=/data/my-oauth.log
#   MYOAUTH_RSA_PRIVATE_KEY_PATH=/data/oauth.private.pem   (auto-generated)
#   MYOAUTH_SECURE_COOKIES=true
#   MYOAUTH_TRUST_PROXY=true
#
# Built-in defaults when nothing is set: httpAddress 0.0.0.0:20476,
# dbPath myoauth.db, logFilePath my-oauth.log,
# rsaPrivateKeyPath oauth.private.pem, authorizationCodeLength 128,
# refreshTokenLength 128, passwordMinLength 8, rateLimitEnabled true,
# rateLimitRequestsPerMinute 30, rateLimitBurst 10, rateLimitMaxKeys 100000.

# --- Required: core ---------------------------------------------------------
# Public issuer URL used in discovery / the JWT `iss` claim and as the default
# forward-auth origin. No trailing slash. REQUIRED.
MYOAUTH_OIDC_ISSUER=https://oauth.example.com
# Hosted login page URL used by /authorize.
MYOAUTH_OIDC_LOGIN_URL=https://oauth.example.com/login
# Shared secret required to register (used by /setup/register, the only
# self-service signup path). REQUIRED: an empty value fails the boot fast rather
# than leaving registration open. Change it before going live.
MYOAUTH_INVITATION_CODE=change-me

# --- Required: admin password (bcrypt hash, never plaintext) -----------------
# Generate a hash, then paste the whole hash here. A bcrypt hash contains `$`
# characters; Docker Compose passes env_file values through literally, but if
# your Compose version warns about interpolation escape each `$` as `$$`.
#
#   # htpasswd (apache2-utils / httpd-tools), cost 12:
#   htpasswd -bnBC 12 "" 'YourStrongPassword' | tr -d ':\n'
#
#   # or with the project's own helper:
#   cat > /tmp/bcrypt.go <<'EOF'
#   package main
#
#   import (
#       "fmt"
#       "os"
#
#       "github.com/zenpk/my-oauth/util"
#   )
#
#   func main() {
#       hash, err := util.BCryptPassword(os.Args[1])
#       if err != nil {
#           panic(err)
#       }
#       fmt.Println(hash)
#   }
#   EOF
#   go run /tmp/bcrypt.go 'YourStrongPassword'
MYOAUTH_ADMIN_PASSWORD=$2a$12$REPLACE_WITH_YOUR_BCRYPT_HASH

# --- Optional: server / storage ---------------------------------------------
# Note: the Docker image sets sensible ENV defaults for all of these (paths under
# /data, secure cookies, trust proxy), so you normally do not need to set them.
# MYOAUTH_HTTP_ADDRESS=0.0.0.0:20476
# MYOAUTH_SECURE_COOKIES=true
# MYOAUTH_TRUST_PROXY=true
# MYOAUTH_DB_PATH=/data/myoauth.db
# MYOAUTH_LOG_FILE_PATH=/data/my-oauth.log
# RSA signing key. The image default is /data/oauth.private.pem and the key is
# auto-generated there on first boot (persist /data, or mount a pre-made key and
# point this at it). A missing parent directory is a hard error: create it first.
# MYOAUTH_RSA_PRIVATE_KEY_PATH=/data/oauth.private.pem
# Comma-separated list of CORS origins allowed to call the API.
# MYOAUTH_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# --- Optional: OIDC token / password lengths ---------------------------------
# MYOAUTH_AUTHORIZATION_CODE_LENGTH=128
# MYOAUTH_REFRESH_TOKEN_LENGTH=128
# MYOAUTH_PASSWORD_MIN_LENGTH=8

# --- Optional: rate limiting -------------------------------------------------
# MYOAUTH_RATE_LIMIT_ENABLED=true
# MYOAUTH_RATE_LIMIT_REQUESTS_PER_MINUTE=30
# MYOAUTH_RATE_LIMIT_BURST=10
# MYOAUTH_RATE_LIMIT_MAX_KEYS=100000

# --- Forward auth (replaces oauth2-proxy) -----------------------------------
# Enable and configure the built-in forward-auth backend (accepted values:
# true/false/1/0/yes/no, case-insensitive). Left commented so a copied `.env`
# does not force an active value. Set MYOAUTH_FORWARD_AUTH_ENABLED=true together
# with the secrets below to enable it; you only need this when you put nginx
# `auth_request` in front of an app; see nginx.forward-auth.example.conf.
# MYOAUTH_FORWARD_AUTH_ENABLED=true
# MYOAUTH_FORWARD_AUTH_CLIENT_ID=proxy
# Required when enabled; generate secrets with `openssl rand -hex 32`:
# MYOAUTH_FORWARD_AUTH_CLIENT_SECRET=
# MYOAUTH_FORWARD_AUTH_COOKIE_SECRET=
# MYOAUTH_FORWARD_AUTH_COOKIE_NAME=_myoauth_proxy
# MYOAUTH_FORWARD_AUTH_COOKIE_DOMAIN=
# Set true whenever the flow is served over HTTPS.
# MYOAUTH_FORWARD_AUTH_COOKIE_SECURE=true
# Session lifetime in seconds. 0 (default) derives it from the proxy client's
# refresh-token age.
# MYOAUTH_FORWARD_AUTH_SESSION_TTL_SECONDS=0
# Exact app origins allowed to run the login flow (comma-separated).
# MYOAUTH_FORWARD_AUTH_ALLOWED_CALLBACK_ORIGINS=https://app.example.com
# Extra hosts accepted for an absolute `rd` return URL (comma-separated).
# MYOAUTH_FORWARD_AUTH_ALLOWED_REDIRECT_DOMAINS=
